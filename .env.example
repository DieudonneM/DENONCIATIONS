# Render-only configuration
# Copy this file to .env and replace placeholder values.

# Environment mode
ENVIRONMENT=production

# Core
SECRET_KEY=change-me-very-secret
DEBUG=False

# Hosts / CORS
ALLOWED_HOSTS=denonciation-abus-rdc.net
CORS_ALLOWED_ORIGINS=https://denonciation-abus-rdc.net

# Database (required)
# The app now requires Render PostgreSQL in all environments.
# Provide either RENDER_DATABASE_URL or DATABASE_URL.
RENDER_DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<database>
# DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<database>

# Optional mail settings
EMAIL_HOST=smtp.hostinger.com
EMAIL_PORT=587
EMAIL_HOST_USER=contact@denonciation-abus-rdc.net
EMAIL_HOST_PASSWORD=change-me
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=Ministere d'Emploi et Travail <contact@denonciation-abus-rdc.net>

# Optional Cloudinary (if used)
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
